# Copie este arquivo para .env.local e preencha com as chaves do projeto Supabase
# (Project Settings > API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://nedthbeekvwzcjrhsghp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente para uso em rotas de servidor (API routes / server actions), NUNCA no client:
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que protege /api/cron/sync-profrotas (sincronização automática de
# integrações). Gere com `openssl rand -hex 32`. Na Vercel, se a env var tiver
# esse nome exato, o próprio agendador de Cron Jobs já manda como
# Authorization: Bearer automaticamente.
CRON_SECRET=
# Chave da API Anthropic (Claude) — usada pelo Assistente FNI (/assistente).
# Pegue em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Fase 27.45 — login com Google direto no domínio do app (Google Identity
# Services), sem passar pelo redirect hospedado pelo Supabase. Use o MESMO
# Client ID que já está em Authentication > Providers > Google no painel do
# Supabase (não é segredo, pode ficar público com NEXT_PUBLIC_). Também
# precisa adicionar "https://fxgestaodefrotasonline.com" (e o domínio de
# testes, se houver) em "Authorized JavaScript origins" desse OAuth Client
# no Google Cloud Console > APIs & Services > Credentials. Sem essa env var,
# o login cai automaticamente no botão antigo (redirect via Supabase).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Hotjar — mapa de calor e gravação de sessão. Pegue o Site ID em
# Hotjar > Settings > Sites & Organizations (é o número "hjid" do snippet
# de instalação). Só é lido em produção (ver src/app/layout.tsx) — em dev
# local o script nem carrega.
NEXT_PUBLIC_HOTJAR_SITE_ID=2318560
# Sentry — monitoramento de erros (Fase Comercial, 31/08/2026). Crie uma
# conta gratuita em sentry.io, crie um projeto Next.js e pegue o DSN em
# Settings > Projects > [seu projeto] > Client Keys (DSN). Sem esta env
# var, o SDK fica em no-op (não quebra nada, só não reporta erro nenhum).
NEXT_PUBLIC_SENTRY_DSN=
# Opcionais — só necessários pra upload de source maps no build (stack
# traces legíveis em produção). Pegue em Settings > Auth Tokens (token com
# escopo "project:releases"), e org/project nos slugs da URL do Sentry.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
