# Copie este arquivo para .env.local e preencha com as chaves do projeto Supabase
# (Project Settings > API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://nedthbeekvwzcjrhsghp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente para uso em rotas de servidor (API routes / server actions), NUNCA no client:
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que protege /api/cron/sync-profrotas (sincronização automática de
# integrações). Gere com `openssl rand -hex 32`. Na Vercel, se a env var tiver
# esse nome exato, o próprio agendador de Cron Jobs já manda como
# Authorization: Bearer automaticamente.
CRON_SECRET=
# Chave da API Anthropic (Claude) — usada pelo Assistente FNI (/assistente).
# Pegue em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
